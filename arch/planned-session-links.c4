// Session links and a back stack (ark-sdlc intent 0770, a design waiting for approval): an agent
// gives Drew a link to a card, kerdr://0591, which his terminal's link key opens in Kerdr, landing
// on that card's workspace wherever it runs; inside herdr, two keys step back and forward through
// the sessions he visited. Everything tagged #planned is planned until it's built.
model {
  agents = service "Agents in herdr panes" {
    description "Coding agents Drew talks to. A rule of his own record system says when to give him a card's link: a card to look at, or a list of them."
  }
  desktop = service "The desktop's link opener" {
    #planned
    description "Foot's link key (Ctrl+Shift+O and a letter) runs xdg-open on a link, and so does a browser, after asking. A desktop file sends kerdr:// to kerdr open; Foot's link pattern gains kerdr:// beside the web's links."
  }
  open = app "kerdr open" {
    #planned
    description "Runs for a kerdr:// link. Takes only a card's id, or a feed's name and an id, and refuses anything else; never runs what a link says or passes it to a shell. Hands the id to the Kerdr window used last, over a socket in the user's own runtime folder, waits for that Kerdr to say it took it, and brings its window to the front. With no Kerdr open, starts one window (one, however many links arrive at once) that lands on the card."
  }
  trail = store "Kerdr's trail of places" {
    #planned
    description "Each Kerdr window's own list of places visited (machine, session, workspace, tab, and the card when there is one), up to 50, in memory. Back goes to the newest earlier place still open, forward undoes it. A closed workspace, or a card's own tab that has closed, is skipped and dropped; a machine not answering is skipped and kept. Going anywhere new drops the places ahead."
  }
  drew -> agents "asks"
  agents -> drew "a card's link after its words: kerdr://0591" {
    #planned
  }
  drew -> desktop "Ctrl+Shift+O, then the link's letter" {
    #planned
  }
  desktop -> open "runs it with the link" {
    #planned
  }
  open -> kerdr "the card's id; Kerdr says it took it" {
    #planned
  }
  drew -> herdr "back and forward keys" {
    #planned
  }
  kerdr -> herdr "hears back or forward; goes to the card or place, on any machine" {
    #planned
  }
  kerdr -> trail "notes the place being left and the one reached" {
    #planned
  }
}
views {
  view planned-session-links {
    title "Planned / Session links and a back stack"
    description """
      ark-sdlc intent 0770, a design waiting for approval. An agent puts a card's link after its
      words, kerdr://0591. Foot's link key hands it to the desktop's link opener, which runs kerdr
      open: it sends the card's id to the Kerdr window used last and brings it to the front, or
      opens a new Kerdr window on the card when none is open. Kerdr goes to the card's workspace
      wherever it runs, as Enter does, but a link only goes: it never starts or reopens work.
      Inside herdr, the back and forward keys leave herdr's usual token for Kerdr, which steps
      through its trail of places, skipping any that have closed.
    """
    include drew, agents, desktop, open, kerdr, herdr, trail
    exclude * -> *
    include agents -> drew, drew -> desktop, desktop -> open, open -> kerdr
    include drew -> herdr, kerdr -> trail
    include kerdr -> herdr where tag is #planned
    style element.tag = #planned {
      color gray
      border dashed
    }
    autoLayout TopBottom
  }
}
