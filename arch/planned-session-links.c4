// Session links and a back stack (ark-sdlc intent 0770, a design approved by Andrew): an agent
// writes a card's number in parentheses after its words, (0591), and Foot's link key, Ctrl+Shift+O,
// opens it in Kerdr, landing on that card's workspace wherever it runs; inside herdr, two keys step
// back and forward through the sessions he visited. Everything tagged #planned is planned until
// it's built.
model {
  agents = service "Agents in herdr panes" {
    description "Coding agents Drew talks to. They already write a card's number in parentheses after its words, under a rule of his own record system; a second rule says to give each card he should go to its own line."
  }
  linkkey = service "Foot's link key" {
    #planned
    description "Ctrl+Shift+O puts a letter on each web link and each card number in parentheses on the screen, (0591), and runs Foot's link opener with what's under the letter pressed, as one argument and without a shell. Its pattern is Foot's own, rebuilt from the installed Foot's on each sync, with card numbers added. Nothing registers a link type with the desktop, so browsers and other programs can't hand Kerdr anything."
  }
  opener = app "foot-link-open" {
    #planned
    description "A few lines from omarchy-config, now Foot's link opener: the exact card form, (0591), goes to kerdr open; anything else goes to xdg-open unchanged, as Foot sends it today. Never runs what it's given, and doesn't depend on Kerdr, so web links open with Kerdr missing."
  }
  open = app "kerdr open" {
    #planned
    description "Runs with a card's number from Foot's link opener. Takes only digits, and refuses anything else; never runs what it's given or passes it to a shell. Hands the number to the Kerdr window used last, over a socket in the user's own runtime folder, as a request only one Kerdr can claim, waits for that Kerdr to say it took it, and brings its window to the front. With no Kerdr open, starts one window (one, however many links arrive at once) that lands on the card."
  }
  trail = store "Kerdr's trail of places" {
    #planned
    description "Each Kerdr window's own list of places visited (machine, session, workspace, tab, and the card when there is one), up to 50, in memory. Back goes to the newest earlier place still open, forward undoes it. A closed workspace, or a card's own tab that has closed, is skipped and dropped; a machine not answering is skipped and kept. Going anywhere new drops the places ahead."
  }
  drew -> agents "asks"
  agents -> drew "a card's number in parentheses after its words: (0591)" {
    #planned
  }
  drew -> linkkey "Ctrl+Shift+O, then the number's letter" {
    #planned
  }
  linkkey -> opener "runs it with what was matched" {
    #planned
  }
  opener -> open "a card number" {
    #planned
  }
  open -> kerdr "the card's number; Kerdr says it took it" {
    #planned
  }
  drew -> herdr "back and forward keys" {
    #planned
  }
  kerdr -> herdr "hears back or forward, if it owns the session; goes to the card or place, on any machine" {
    #planned
  }
  kerdr -> trail "notes the place being left and the one reached" {
    #planned
  }
}
views {
  view planned-session-links {
    title "Planned / Session links and a back stack"
    description """
      ark-sdlc intent 0770, a design Andrew approved. An agent writes a card's number in
      parentheses after its words, (0591), as his rule on numbers already has it. Foot's link key,
      Ctrl+Shift+O, finds it beside web links and hands it to Foot's link opener, which sends card
      numbers to kerdr open and everything else to xdg-open as before. kerdr open sends the number
      to the Kerdr window used last and brings it to the front, or opens a new Kerdr window on the
      card when none is open. Kerdr goes to the card's workspace wherever it runs, as Enter does,
      but a link only goes: it never starts or reopens work. Inside herdr, the back and forward
      keys leave herdr's usual token for Kerdr; the Kerdr that owns the session steps through its
      trail of places, skipping any that have closed.
    """
    include drew, agents, linkkey, opener, open, kerdr, herdr, trail
    exclude * -> *
    include agents -> drew, drew -> linkkey, linkkey -> opener, opener -> open, open -> kerdr
    include drew -> herdr, kerdr -> trail
    include kerdr -> herdr where tag is #planned
    style element.tag = #planned {
      color gray
      border dashed
    }
    autoLayout TopBottom
  }
}
